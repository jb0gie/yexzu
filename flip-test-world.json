{
  "name": "Test World",
  "author": "Test",
  "version": "1.0.0",
  "script": `
({
  name: 'Flip Animation Test',

  init() {
    console.log('[FLIP TEST] Starting flip animation test')

    // Test both flip animations directly
    setTimeout(() => {
      console.log('[FLIP TEST] Testing LEFT flip animation...')
      world.entities.player.applyEffect({
        emote: 'asset://emote-flip-left.glb?s=1.1&l=0',
        duration: 2.0,
        cancellable: false
      })
    }, 2000)

    setTimeout(() => {
      console.log('[FLIP TEST] Testing RIGHT flip animation...')
      world.entities.player.applyEffect({
        emote: 'asset://emote-flip-right.glb?s=1.1&l=0',
        duration: 2.0,
        cancellable: false
      })
    }, 5000)
  },

  update(delta) {
    // Simple update loop
  }
})
  `
}